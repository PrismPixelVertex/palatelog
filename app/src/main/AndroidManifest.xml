<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location for GPS tagging and distance queries -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Background Location & Foreground Service for on-demand Palate Radar highway scanning -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Camera for in-app dish & bill photo capture via CameraX -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Notifications for sync health and family updates (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network for OpenStreetMap tiles and Google Drive sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Hardware requirements: Require touchscreen to filter out Android TV boxes -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true"
        tools:ignore="UnnecessaryRequiredFeature" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Package visibility queries for navigation intents (Android 11+) -->
    <queries>
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".PalateLogApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PalateLog"
        tools:ignore="RemoveWorkManagerInitializer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PalateLog"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Disable default WorkManager initializer for Hilt custom Configuration.Provider -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <!-- FileProvider for capturing camera images securely -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Palate Radar Location Foreground Service -->
        <service
            android:name=".core.service.PalateRadarService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Palate Radar Quick Settings Tile -->
        <service
            android:name=".core.service.PalateRadarTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification_restaurant"
            android:label="@string/radar_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Palate Radar Geofence Broadcast Receiver -->
        <receiver
            android:name=".core.radar.PalateRadarReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.prismpixelvertex.palatelog.ACTION_RADAR_GEOFENCE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
